                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Заказ успешно удалён"
                    }
                }
            }
        },
        "/api/orders/search-by-product": {
            "get": {
                "tags": [
                    "Заказы"
                ],
                "summary": "Поиск заказов по ID товара через сервис заказов",
                "description": "Перенаправляет запрос на поиск заказов по ID товара в сервис заказов.",
                "operationId": "262d83b32b65ad22a891049796d1b6f8",
                "parameters": [
                    {
                        "name": "product_id",
                        "in": "query",
                        "description": "ID товара для поиска заказов",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Список заказов, содержащих указанный товар",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "type": "object"
                                    }
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Ошибка валидации"
                    },
                    "500": {
                        "description": "Ошибка сервиса заказов"
                    }
                }
            }
        },
        "/api/products": {
            "get": {
                "tags": [
                    "Продукты"
                ],
                "summary": "Получить список продуктов c возможностью поиска. Укажите параметр search для поиска по имени",
