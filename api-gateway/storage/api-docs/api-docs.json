                "parameters": [
                    {
                        "name": "search",
                        "in": "query",
                        "description": "Поисковая строка для поиска по имени продукта",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "example": "example product name"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Список продуктов",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "type": "object"
                                    }
                                }
                            }
                        }
                    }
                }
            },
